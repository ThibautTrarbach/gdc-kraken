# Django (obligatoires / recommandés)
SECRET_KEY=change-me-long-random
PLATFORM=DOCKER
ALLOWED_HOSTS=localhost,127.0.0.1,grecedecanards.fr
CSRF_TRUSTED_ORIGINS=https://grecedecanards.fr

# Optionnel Django
# DEBUG=false
TIME_ZONE=Europe/Paris
# LANGUAGE_CODE=en-us
# STATIC_URL=/static/
# MEDIA_URL=/media/

# Reverse-proxy (HTTPS) — requis derrière Traefik
# (déjà activés automatiquement si PLATFORM=DOCKER ou PROD)
USE_X_FORWARDED_HOST=true
USE_X_FORWARDED_PROTO=true

# Site Django (callbacks OAuth Discord/Steam)
# SITE_ID=1
# SITE_DOMAIN=grecedecanards.fr
# SITE_NAME=GDC Storm

# Auth sociale (optionnel — désactivé par défaut)
# Un provider n'est actif que si le flag est true ET les credentials sont présents.
# Redirect Discord : https://<domaine>/accounts/discord/login/callback/
# Redirect Steam  : https://<domaine>/accounts/steam/login/callback/
AUTH_DISCORD_ENABLED=false
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
AUTH_STEAM_ENABLED=false
# STEAM_API_KEY=

# Chemins conteneur
MISSIONS_PBO_STORAGE_PATH=/data/missions_pbo
MISSIONS_STORAGE_PATH=missions
MISSIONS_IMAGES_STORAGE_PATH=missions/images
SQLITE_PATH=/data/persist/db.sqlite3
MEDIA_ROOT=/data/persist/missions
# STATIC_ROOT=/app/staticfiles

# Uploads (octets) — utile pour gros PBO
# FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
# DATA_UPLOAD_MAX_NUMBER_FIELDS=100000

# Compose / host
HOST_PORT=6130
MISSIONS_PBO_HOST_PATH=/var/lib/pterodactyl/volumes/ffaffcc4-773f-490a-a116-76dd7109fe7e

# Utilisateur runtime du conteneur (pas d'utilisateur nommé hardcodé)
# Aligner sur le propriétaire du bind-mount host si besoin (ex. Pterodactyl: 999:987)
PUID=1000
PGID=1000

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_TIMEOUT=120
